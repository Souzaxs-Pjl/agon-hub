# =====================================================================
# AGON Hub - exemplo de configuração do backend
#
# COMO USAR: copie este arquivo para ".env" (na mesma pasta) e preencha
# com os seus valores:
#     cp .env.example .env          (Linux/Mac)
#     copy .env.example .env        (Windows)
#
# O arquivo ".env" contém senhas e NUNCA deve ir para o GitHub
# (o .gitignore já cuida disso). Este arquivo ".env.example" pode ir.
# =====================================================================

# --- Servidor ---
PORT=3000
# Endereço do frontend (liberado no CORS)
FRONTEND_URL=http://localhost:5173

# --- Banco de dados PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=coloque_a_senha_do_seu_postgres
DB_NAME=agon_hub

# --- Autenticação JWT ---
# Segredo usado para assinar os tokens. Precisa ter 32 caracteres ou mais.
# Gere um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
# Validade do token (ex.: 30m, 2h, 7d)
JWT_EXPIRES_IN=2h

# --- Administrador (usado SOMENTE por: npm run criar-admin) ---
# Escolha o seu e-mail e uma senha forte (mínimo 8 caracteres).
ADMIN_NOME=Administrador AGON
ADMIN_EMAIL=
ADMIN_SENHA=
